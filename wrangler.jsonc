{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-app-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },
  "vars": {
    "ANTHROPIC_BASE_URL": "https://api.portkey.ai",
    "ANTHROPIC_MODEL": "@bedrock-global/us.anthropic.claude-opus-5-5",
    "SCHEDULE_TIMEZONE": "America/New_York",
    "SCHEDULE_HOUR": "7"
  },
  // Secrets (never in code): ANTHROPIC_API_KEY (Portkey key), YDC_API_KEY (You.com), AGENT_PASSWORD (guards /agent); set each with `wrangler secret put <NAME>`
  // 7 AM New York is 11:00 UTC in summer and 12:00 UTC in winter; the handler runs only the matching one.
  "triggers": { "crons": ["0 11 * * *", "0 12 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "news-db",
      "database_id": "60c92c63-75fb-4a60-8390-edab56415d0b",
      "migrations_dir": "migrations"
    }
  ]
}
