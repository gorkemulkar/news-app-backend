// Cloudflare Pages config for the dashboard: static files only, no bindings.
// Deploy from this directory: npx wrangler pages deploy
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "news-app-dashboard",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-20"
}
